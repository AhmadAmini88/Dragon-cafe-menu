mportant;
  background:rgba(79,179,255,.08)!important;
  color:#fff!important;
  border-radius:13px!important;
  padding:9px 16px!important;
  font-family:inherit!important;
  font-weight:850!important;
}
.jalali-picker{
  position:fixed;
  z-index:250!important;
  width:min(340px,calc(100vw - 24px));
  padding:12px;
  border-radius:22px;
  background:linear-gradient(145deg,rgba(18,54,98,.98),rgba(8,22,48,.99));
  border:1px solid rgba(144,202,255,.25);
  box-shadow:0 28px 80px rgba(0,0,0,.55);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}
.jalali-picker.hidden{display:none}
.jalali-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}
.jalali-head strong{font-size:14px}
.jalali-nav{display:flex;gap:5px}
.jalali-nav button,.jalali-picker .pick-close{
  width:34px;height:34px;border-radius:11px;border:1px solid rgba(144,202,255,.18);
  background:rgba(79,179,255,.08);color:#fff;font-family:inherit;cursor:pointer;
}
.jalali-week,.jalali-days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}
.jalali-week span{text-align:center;font-size:9px;color:var(--text-dim);padding:3px 0}
.jalali-day{
  min-height:34px;border:1px solid rgba(144,202,255,.12);border-radius:10px;
  background:rgba(255,255,255,.035);color:#fff;font-family:inherit;font-size:11px;cursor:pointer;
}
.jalali-day.muted{opacity:.28;pointer-events:none}
.jalali-day.active{background:linear-gradient(135deg,var(--blue),var(--indigo));border-color:rgba(255,255,255,.28);box-shadow:0 0 18px rgba(79,179,255,.24)}
.jalali-time-row{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:center;margin-top:10px;padding-top:10px;border-top:1px solid rgba(144,202,255,.12)}
.jalali-time-row label{font-size:10px;color:var(--text-dim)}
.jalali-time-row input{height:38px;border-radius:11px;border:1px solid rgba(144,202,255,.18);background:rgba(6,18,38,.55);color:#fff;font-family:inherit;text-align:center}
.jalali-actions{display:flex;justify-content:space-between;gap:8px;margin-top:10px}
.jalali-actions button{flex:1}
.jalali-display{direction:ltr;text-align:center;font-variant-numeric:tabular-nums}
.login-dragon{overflow:hidden}
.login-dragon img{width:100%;height:100%;object-fit:contain;padding:4px;display:block}
@media(max-width:600px){
  .bottom-bar.admin-mode{right:calc(var(--sidebar-w) + 7px)!important;left:7px!important}
  .search-row{margin:7px 9px 0!important}
  .file-field{grid-template-columns:minmax(0,1fr)!important}
  .file-name{font-size:9px!important;padding:8px 10px!important}
  .price-wrap{min-width:92px!important;max-width:66%!important;padding:7px 9px!important;border-radius:14px!important}
  .price-wrap .old-price{font-size:9.5px!important}
  .price-wrap .price{font-size:clamp(15px,4.5vw,18px)!important}
  .price-wrap .price .unit{font-size:clamp(8px,2.4vw,10px)!important}
  .jalali-picker{width:calc(100vw - 18px);padding:10px}
}
@media(max-width:380px){
  .price-wrap{min-width:88px!important;max-width:68%!important;padding:6px 8px!important}
  .price-wrap .old-price{font-size:9px!important}
  .price-wrap .price{font-size:14px!important}
  .price-wrap .price .unit{font-size:7.5px!important}
}
</style>


<style id="dragon-v4-final-fixes">
/* ===== DRAGON V4 RESPONSIVE / UX FIXES ===== */
.box-sizing-fix,
.file-field,
.file-field *{box-sizing:border-box!important}
.file-field{width:100%!important;min-width:0!important;display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr)!important;align-items:center!important;gap:8px!important}
.file-field .file-btn{min-width:0!important;width:100%!important;max-width:100%!important;overflow:hidden!important}
.file-field .file-btn span{min-width:0!important;max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}
.file-name{min-width:0!important;width:100%!important;max-width:100%!important;display:block!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}
.modal{max-width:min(680px,94vw)!important}
.modal-body{min-width:0!important;overflow-x:hidden!important}
.modal-headline{min-width:0!important}
.modal-headline h2{min-width:0!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}
/* Price: match the premium quantity/cart visual hierarchy. */
.item-foot{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;min-width:0!important}
.item-foot>.add-control{flex:0 1 auto!important;min-width:96px!important;max-width:42%!important}
.price-wrap{flex:0 1 auto!important;min-width:108px!important;max-width:62%!important;padding:9px 13px!important;border-radius:16px!important;display:flex!important;flex-direction:column!important;align-items:flex-end!important;justify-content:center!important;gap:2px!important;box-sizing:border-box!important;background:linear-gradient(135deg,rgba(79,179,255,.16),rgba(124,108,255,.11))!important;border:1px solid rgba(144,202,255,.25)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.10),0 10px 26px rgba(20,80,150,.10)!important}
.price-wrap .old-price{font-size:10.5px!important;line-height:1.1!important;color:rgba(230,240,255,.55)!important;text-decoration:line-through!important;white-space:nowrap!important;max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important}
.price-wrap .price{font-size:clamp(17px,2.3vw,21px)!important;line-height:1.1!important;font-weight:950!important;color:#fff!important;white-space:nowrap!important;max-width:100%!important;overflow:hidden!important;text-overflow:ellipsis!important;text-shadow:0 0 18px rgba(79,179,255,.22)!important}
.price-wrap .price .unit{font-size:clamp(9px,1.1vw,11px)!important;color:rgba(220,235,255,.75)!important;font-weight:850!important;white-space:nowrap!important}
/* Search popup should sit above content but visually below sticky toolbar. */
.search-row{position:relative!important;z-index:29!important;margin:8px 12px 0!important;padding:0!important;isolation:isolate!important}
.search-row input{position:relative!important;z-index:1!important}
.toolbar{position:sticky!important;z-index:40!important}
.search-row.show{display:block!important}
/* Admin bottom bar: always stay left of the 64px category rail, never scroll horizontally. */
.bottom-bar.admin-mode{position:fixed!important;right:calc(var(--sidebar-w) + 8px)!important;left:8px!important;z-index:70!important;display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-auto-rows:minmax(46px,auto)!important;overflow:hidden!important;white-space:normal!important}
.bottom-bar.admin-mode .bb-btn{min-width:0!important;width:100%!important;max-width:100%!important;overflow:hidden!important}
@media(max-width:600px){
  .file-field{grid-template-columns:minmax(0,1fr)!important;gap:7px!important}
  .file-name{font-size:9px!important;padding:8px 10px!important}
  .item-foot{gap:7px!important}
  .item-foot>.add-control{min-width:88px!important;max-width:39%!important}
  .price-wrap{min-width:100px!important;max-width:64%!important;padding:8px 10px!important;border-radius:15px!important}
  .price-wrap .old-price{font-size:9px!important}
  .price-wrap .price{font-size:clamp(16px,4.8vw,19px)!important}
  .price-wrap .price .unit{font-size:clamp(8px,2.5vw,10px)!important}
  .modal{width:calc(100vw - 20px)!important;max-width:none!important}
  .bottom-bar.admin-mode{right:calc(var(--sidebar-w) + 7px)!important;left:7px!important;bottom:max(7px,env(safe-area-inset-bottom))!important;gap:6px!important;padding:6px!important}
  .bottom-bar.admin-mode .bb-btn{height:44px!important;padding:6px 5px!important;font-size:10px!important}
  .bottom-bar.admin-mode .bb-label{font-size:9px!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
}
@media(max-width:380px){
  .price-wrap{min-width:92px!important;max-width:67%!important;padding:7px 8px!important}
  .price-wrap .price{font-size:15px!important}
  .price-wrap .old-price{font-size:8.5px!important}
  .price-wrap .price .unit{font-size:7px!important}
}
</style>


<style id="dragon-v5-polish-20260917">
/* ===== DRAGON V5 POLISH — MOBILE ADMIN, FEATURED HEADING, PRICES, THEME ===== */
:root{
  --sale:#61f3ff;
  --old:#ff9898;
}

/* Featured heading: 3 logical zones — icon, title/dash, left-side pricing note. */
.cat-heading{
  display:grid!important;
  grid-template-columns:auto minmax(0,1fr) minmax(92px,28%);
  align-items:center!important;
  gap:10px!important;
  min-width:0!important;
}
.cat-heading .em{flex:0 0 auto;}
.cat-heading-main{
  min-width:0!important;
  display:flex!important;
  align-items:center!important;
  gap:10px!important;
  overflow:hidden!important;
}
.cat-heading-main h1{
  min-width:0!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  white-space:nowrap!important;
}
.cat-heading-main .dash{flex:1 1 auto!important;min-width:14px!important;}
.cat-heading .sub{
  min-width:0!important;
  max-width:100%!important;
  margin:0!important;
  text-align:left!important;
  direction:rtl!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  white-space:nowrap!important;
  justify-self:stretch!important;
}

/* File picker filename: never escapes, always centered. */
.file-name{
  text-align:center!important;
  direction:rtl!important;
  min-height:36px!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  line-height:1.5!important;
}

/* Product image fallback is the main Dragon logo, including broken-image cases. */
.photo-fallback{
  position:absolute!important;
  inset:0!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  padding:14px!important;
  background:radial-gradient(circle,rgba(0,229,255,.10),transparent 70%)!important;
  z-index:1!important;
}
.site-logo-fallback{
  width:78%!important;
  height:78%!important;
  object-fit:contain!important;
  display:block!important;
  filter:drop-shadow(0 10px 26px rgba(0,100,255,.24))!important;
  opacity:.92!important;
}
.cat-logo-fallback{width:84%!important;height:84%!important;}
.real-photo{position:relative!important;z-index:2!important;}
.real-photo.failed{opacity:0!important;pointer-events:none!important;}

/* Premium price glass: larger typography, clear two-price layout and theme-aware colors. */
.price-wrap{
  min-width:116px!important;
  max-width:min(68%,255px)!important;
  padding:9px 12px!important;
  border-radius:17px!important;
  align-items:flex-end!important;
  gap:3px!important;
  background:linear-gradient(145deg,rgba(0,229,255,.13),rgba(0,80,255,.10))!important;
  border:1px solid rgba(120,225,255,.30)!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 12px 28px rgba(0,25,80,.18)!important;
  backdrop-filter:blur(14px)!important;
  -webkit-backdrop-filter:blur(14px)!important;
}
.price-wrap .old-price{
  color:var(--old)!important;
  font-size:11px!important;
  font-weight:800!important;
  line-height:1.15!important;
  opacity:.92!important;
}
.price-wrap .price{
  color:var(--sale)!important;
  font-size:clamp(18px,2.2vw,24px)!important;
  font-weight:950!important;
  line-height:1.12!important;
  text-shadow:0 0 16px var(--sale)!important;
}
.price-wrap .price .unit{
  color:var(--text)!important;
  opacity:.78!important;
  font-size:clamp(9px,1.1vw,11px)!important;
  font-weight:800!important;
}

/* Whole-site theme controls in admin. */
.theme-grid{grid-template-columns:repeat(5,minmax(0,1fr))!important;}
.theme-neon .theme-dot{background:linear-gradient(135deg,#00e5ff,#0050ff,#2dffb9)!important}
.theme-midnight .theme-dot{background:linear-gradient(135deg,#3c8ce7,#2563eb,#25e9c9)!important}
.theme-colors-panel{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
  margin-top:10px;
  padding:10px;
  border-radius:15px;
  background:rgba(0,0,0,.10);
  border:1px solid var(--border);
}
.color-control{
  display:flex;
  align-items:center;
  gap:8px;
  min-width:0;
  height:40px;
  padding:5px 8px;
  border-radius:12px;
  border:1px solid var(--border);
  background:rgba(255,255,255,.04);
}
.color-control input[type=color]{
  width:30px!important;
  height:30px!important;
  padding:0!important;
  border:0!important;
  background:transparent!important;
  flex:0 0 auto;
}
.color-control span{
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  direction:ltr;
  font:700 10px/1.1 monospace;
  opacity:.8;
}

/* Admin navigation is always at the top of the current management modal — no bottom overlap. */
.admin-section-nav{
  position:sticky;
  top:0;
  z-index:30;
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:7px;
  margin:0 0 14px;
  padding:8px;
  border-radius:18px;
  background:linear-gradient(145deg,rgba(0,80,160,.34),rgba(27,34,96,.30));
  border:1px solid rgba(140,220,255,.18);
  box-shadow:0 12px 30px rgba(0,20,70,.16),inset 0 1px 0 rgba(255,255,255,.08);
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
}
.admin-section-nav button{
  min-width:0;
  min-height:42px;
  padding:7px 6px;
  border-radius:13px;
  border:1px solid rgba(144,202,255,.15);
  background:rgba(255,255,255,.04);
  color:var(--text);
  font-family:inherit;
  font-size:10px;
  font-weight:900;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  overflow:hidden;
  transition:.18s ease;
}
.admin-section-nav button i{color:var(--blue);font-size:13px;flex:0 0 auto}
.admin-section-nav button span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.admin-section-nav button.active,
.admin-section-nav button:hover{
  border-color:var(--blue);
  background:rgba(79,179,255,.11);
  box-shadow:0 0 0 2px rgba(79,179,255,.08);
}
body.admin-modal-open .bottom-bar.admin-mode{display:none!important;pointer-events:none!important;visibility:hidden!important}
body.admin-modal-open .admin-banner{opacity:.2}

/* Modal content should have full usable width after top navigation is inserted. */
.modal-body{min-width:0!important;overflow-x:hidden!important}
.modal-body > *{max-width:100%}

@media(max-width:720px){
  .cat-heading{grid-template-columns:auto minmax(0,1fr) minmax(82px,28%)!important;gap:7px!important;padding:12px 9px 7px!important}
  .cat-heading-main{gap:7px!important}
  .cat-heading .em{font-size:21px!important}
  .cat-heading-main h1{font-size:16px!important}
  .cat-heading-main .dash{min-width:10px!important}
  .cat-heading .sub{font-size:8px!important;text-align:left!important;}
  .price-wrap{min-width:108px!important;max-width:66%!important;padding:8px 10px!important;border-radius:15px!important}
  .price-wrap .price{font-size:clamp(18px,5vw,22px)!important}
  .price-wrap .old-price{font-size:9.5px!important}
  .price-wrap .price .unit{font-size:8.5px!important}
  .theme-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .theme-colors-panel{grid-template-columns:1fr!important}
  .admin-section-nav{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin-bottom:11px;padding:7px}
  .admin-section-nav button{min-height:40px;font-size:9px}
}
@media(max-width:380px){
  .cat-heading{grid-template-columns:auto minmax(0,1fr) 76px!important;gap:6px!important}
  .cat-heading .sub{font-size:7px!important}
  .price-wrap{min-width:100px!important;max-width:68%!important;padding:7px 8px!important}
  .price-wrap .price{font-size:18px!important}
  .price-wrap .old-price{font-size:8.5px!important}
  .price-wrap .price .unit{font-size:7.5px!important}
}
</style>


<style id="dragon-v6-final-fixes">
/* ===== DRAGON V6 FINAL — responsive featured header, premium prices, modal chrome, theme ===== */
:root{
  --theme-bg:#050b1b;
  --theme-surface:rgba(10,24,52,.62);
  --theme-surface-strong:rgba(13,31,67,.84);
  --theme-border:rgba(107,208,255,.20);
  --theme-glow:rgba(0,229,255,.20);
}

/* Whole-site theme surface */
