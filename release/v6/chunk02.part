            justify-content: center;
            box-shadow: 0 0 24px rgba(79, 179, 255, 0.4);
            flex-shrink: 0;
            font-size: 22px;
            color: #fff;
            transition: var(--transition);
        }
        .add-btn:active { transform: scale(0.9); }
        .add-btn:disabled {
            background: #3a4152;
            box-shadow: none;
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* bottom bar */
        .bottom-bar {
            position: fixed;
            bottom: 16px;
            right: calc(var(--sidebar-w) + 16px);
            left: 16px;
            z-index: 35;
            background: var(--glass-strong);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 10px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
        }
        .bb-btn {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 700;
            color: var(--text-dim);
            white-space: nowrap;
            transition: var(--transition);
            padding: 6px 10px;
            border-radius: 999px;
        }
        .bb-btn:hover { color: #fff; background: rgba(255, 255, 255, 0.05); }
        .bb-btn.cart-total { color: var(--gold); font-size: 13px; }

        .fab-add {
            position: fixed;
            bottom: 80px;
            right: calc(var(--sidebar-w) + 20px);
            z-index: 36;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--blue), var(--indigo));
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            color: #fff;
            box-shadow: 0 10px 30px rgba(79, 179, 255, 0.5);
            transition: var(--transition);
        }
        .fab-add.show { display: flex; }
        .fab-add:active { transform: scale(0.9); }

        /* order tracking / bottom actions */
        .bottom-bar .bb-btn{min-width:92px;justify-content:center;gap:6px}
        .tracking-summary{display:grid;gap:10px;margin-top:12px}
        .tracking-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px;border:1px solid var(--border);border-radius:16px;background:rgba(79,179,255,.08)}
        .tracking-id{font-weight:900;color:var(--blue)}
        .timeline{display:grid;gap:10px;margin-top:14px}
        .timeline-step{display:grid;grid-template-columns:28px 1fr;gap:10px;align-items:start;opacity:.48}
        .timeline-step.done,.timeline-step.active{opacity:1}
        .timeline-dot{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);border:1px solid var(--border);font-size:12px}
        .timeline-step.done .timeline-dot,.timeline-step.active .timeline-dot{background:rgba(79,179,255,.18);border-color:rgba(79,179,255,.55);box-shadow:0 0 18px rgba(79,179,255,.22)}
        .timeline-title{font-weight:800;font-size:13px}.timeline-time{font-size:10px;color:var(--text-dim);margin-top:3px}
        .login-box{display:grid;gap:12px}.login-note{font-size:11px;color:var(--text-dim);line-height:1.8}
        @media (prefers-reduced-motion: reduce){.timeline-step,.bb-btn,.fab-add{transition:none!important;animation:none!important}}

        /* admin banner */
        .admin-banner {
            display: none;
            margin: 12px 16px 0;
            padding: 12px 18px;
            border-radius: 16px;
            background: rgba(255, 209, 102, 0.10);
            border: 1px solid rgba(255, 209, 102, 0.3);
            color: var(--gold);
            font-size: 12.5px;
            font-weight: 700;
            text-align: center;
            backdrop-filter: blur(8px);
        }
        .admin-banner.show { display: block; animation: fadeIn 0.3s ease; }

        /* modals */
        .modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 60;
            background: rgba(4, 7, 16, 0.7);
            backdrop-filter: blur(6px);
            display: none;
            align-items: flex-end;
            justify-content: center;
            padding: 20px;
        }
        .modal-backdrop.open { display: flex; }
        .modal {
            width: 100%;
            max-width: 500px;
            max-height: 90vh;
            overflow-y: auto;
            background: rgba(12, 19, 40, 0.95);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-radius: 28px 28px 20px 20px;
            border: 1px solid var(--border);
            animation: slideUp 0.25s ease-out;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
        }
        @keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .modal-hero {
            position: relative;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 80px;
            overflow: hidden;
            background: linear-gradient(135deg, #1a2744, #2a3a6a);
        }
        .modal-hero .overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(6, 11, 26, 0.1) 40%, rgba(6, 11, 26, 0.8) 100%);
        }
        .modal-hero .center-emoji {
            position: relative;
            z-index: 2;
            text-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
        }
        .modal-close {
            position: absolute;
            top: 14px;
            left: 14px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(6, 11, 26, 0.6);
            backdrop-filter: blur(4px);
            border: 1px solid var(--border);
            color: #fff;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 5;
            transition: var(--transition);
        }
        .modal-close:hover { background: rgba(255, 255, 255, 0.15); }
        .modal-body {
            padding: 20px 22px 28px;
            text-align: right;
        }
        .modal-body h2 { font-size: 20px; font-weight: 800; }
        .modal-body .divider {
            border-top: 1px dashed var(--border);
            margin: 14px 0;
        }
        .modal-body .desc {
            font-size: 14px;
            color: var(--text-dim);
            line-height: 1.9;
        }
        .modal-foot {
            margin-top: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .modal-add {
            background: linear-gradient(135deg, var(--blue), var(--indigo));
            color: #fff;
            font-weight: 800;
            font-size: 14px;
            padding: 12px 26px;
            border-radius: 999px;
            white-space: nowrap;
            box-shadow: 0 6px 20px rgba(79, 179, 255, 0.3);
            transition: var(--transition);
        }
        .modal-add:active { transform: scale(0.95); }
        .modal-add:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            box-shadow: none;
        }

        /* cart modal */
        .cart-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }
        .cart-item .ci-img {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            overflow: hidden;
            flex-shrink: 0;
            background: #0a1022;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            background: linear-gradient(135deg, #1a2744, #2a3a6a);
        }
        .cart-item .ci-img img {
            object-fit: cover;
            width: 100%;
            height: 100%;
        }
        .cart-item .ci-info { flex: 1; }
        .cart-item .ci-name { font-weight: 700; font-size: 14px; }
        .cart-item .ci-price { font-size: 13px; color: var(--gold); }
        .cart-item .ci-qty {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .cart-item .ci-qty button {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--glass);
            border: 1px solid var(--border);
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }
        .cart-item .ci-qty button:hover { background: rgba(255, 255, 255, 0.08); }
        .cart-item .ci-qty span {
            font-weight: 700;
            min-width: 20px;
            text-align: center;
        }
        .cart-empty {
            color: var(--text-dim);
            text-align: center;
            padding: 30px 0;
            font-size: 14px;
        }

        /* admin form */
        .form-grid {
            display: flex;
            flex-direction: column;
            gap: 12px;
            text-align: right;
        }
        .form-grid label {
            font-size: 12px;
            color: var(--text-dim);
            display: block;
            margin-bottom: 4px;
            font-weight: 600;
        }
        .form-grid input,
        .form-grid select,
        .form-grid textarea {
            width: 100%;
            padding: 10px 14px;
            border-radius: 14px;
            border: 1px solid var(--border);
            background: var(--glass);
            color: var(--text);
            font-family: inherit;
            font-size: 13px;
            transition: var(--transition);
        }
        .form-grid input:focus,
        .form-grid select:focus,
        .form-grid textarea:focus {
            outline: none;
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(79, 179, 255, 0.15);
        }
        .form-grid textarea {
            resize: vertical;
            min-height: 60px;
        }
        .form-row2 {
            display: flex;
            gap: 12px;
        }
        .form-row2>div { flex: 1; }
        .chk-row {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: var(--text-dim);
        }
        .chk-row input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--blue);
            cursor: pointer;
        }
        .form-actions {
            display: flex;
            gap: 12px;
            margin-top: 8px;
        }
        .btn {
            flex: 1;
            padding: 12px;
            border-radius: 16px;
            font-weight: 800;
            font-size: 13px;
            text-align: center;
            transition: var(--transition);
        }
        .btn-save {
            background: linear-gradient(135deg, var(--blue), var(--indigo));
            color: #fff;
            box-shadow: 0 6px 20px rgba(79, 179, 255, 0.25);
        }
        .btn-del {
            background: rgba(255, 107, 129, 0.12);
            color: var(--danger);
            border: 1px solid rgba(255, 107, 129, 0.3);
        }
        .btn:active { transform: scale(0.96); }

        /* toast */
        .toast {
            position: fixed;
            bottom: 90px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            background: var(--cyan);
            color: #052024;
            font-weight: 800;
            font-size: 13px;
            padding: 12px 24px;
            border-radius: 999px;
            opacity: 0;
            pointer-events: none;
            transition: 0.3s ease;
            z-index: 70;
            white-space: nowrap;
            max-width: 85vw;
            overflow: hidden;
            text-overflow: ellipsis;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
        }
        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        /* welcome popup */
        .welcome-popup {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(6, 11, 26, 0.3);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            animation: fadeIn 0.5s ease;
            pointer-events: none;
        }
        .welcome-popup.hide {
            opacity: 0;
            transition: opacity 0.6s ease;
            pointer-events: none;
        }
        .welcome-popup .popup-box {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border);
            border-radius: 32px;
            padding: 40px 48px;
            text-align: center;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
            max-width: 420px;
            width: 90%;
            pointer-events: auto;
        }
        .welcome-popup .popup-box .dragon-icon {
            font-size: 64px;
            background: linear-gradient(135deg, #4fb3ff, #7c6cff, #57e0e0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 8px;
            display: block;
        }
        .welcome-popup .popup-box h2 {
            font-size: 28px;
            font-weight: 900;
            background: linear-gradient(90deg, #4fb3ff, #7c6cff, #57e0e0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 2px;
        }
        .welcome-popup .popup-box p {
            color: var(--text-dim);
            font-size: 14px;
            margin-top: 8px;
        }

        /* responsive */
        @media (max-width: 600px) {
            :root { --sidebar-w: 64px; }
            .items {
                grid-template-columns: 1fr;
                padding: 12px 12px 120px;
                gap: 16px;
            }
            .cat-featured .items { grid-template-columns: 1fr; }
            .toolbar {
                margin: 8px 8px 0;
                padding: 4px 8px 4px 4px;
                border-radius: 40px;
            }
            .brand-pill .brand-text { font-size: 11px; }
            .brand-pill .logo {
                width: 28px;
                height: 28px;
                font-size: 16px;
            }
            .brand-pill {
                max-width: 130px;
                padding: 3px 8px 3px 4px;
            }
            .cat-heading h1 {
                font-size: 17px;
                white-space: normal;
            }
            .cat-heading .sub { font-size: 10px; }
            .bottom-bar {
                right: calc(var(--sidebar-w) + 12px);
                left: 12px;
                padding: 8px 12px;
                bottom: 12px;
            }
            .bb-btn {
                font-size: 11px;
                padding: 4px 8px;
            }
            .fab-add {
                right: calc(var(--sidebar-w) + 14px);
                bottom: 74px;
                width: 48px;
                height: 48px;
                font-size: 24px;
            }
            .modal-backdrop { padding: 10px; }
            .modal {
                max-height: 94vh;
                border-radius: 24px 24px 16px 16px;
            }
            .modal-hero { height: 160px; }
            .modal-body { padding: 18px 16px 24px; }
            .welcome-popup .popup-box { padding: 30px 24px; }
            .welcome-popup .popup-box h2 { font-size: 22px; }
            .form-row2 { flex-direction: column; gap: 12px; }
        }
