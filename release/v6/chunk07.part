    <!-- admin: integration -->
    <div class="modal-backdrop" id="integrationBackdrop">
        <div class="modal">
            <div class="modal-body">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;">
                    <h2 style="font-size:20px;"><i class="fas fa-plug" style="margin-left:8px;"></i>اتصال به زعفران</h2>
                    <button class="modal-close" onclick="closeIntegrationSettings()" style="position:static;"><i class="fas fa-times"></i></button>
                </div>
                <div class="divider"></div>
                <p style="color:var(--text-dim);font-size:12px;line-height:1.8;">آدرس Bridge/API را اینجا تنظیم کن. منو سفارش را به این آدرس با POST ارسال می‌کند؛ تا زمان راه‌اندازی Bridge سفارش‌ها روی همین دستگاه در صف محلی نگه داشته می‌شوند.</p>
                <div class="form-grid" style="margin-top:12px;">
                    <div><label>آدرس API / Bridge</label><input id="apiBaseUrl" type="text" placeholder="https://your-domain.example"></div>
                    <div><label>کلید دسترسی (اختیاری)</label><input id="apiToken" type="password" placeholder="API Token"></div>
                    <div class="chk-row"><input type="checkbox" id="apiEnabled"> ارسال خودکار سفارش به API</div>
                    <div class="admin-settings-card"><h3><i class="fas fa-sliders-h"></i> تنظیمات سفارش و ظاهر</h3>
                      <div class="form-row2"><div><label>حداکثر تعداد اقلام در هر سفارش</label><input id="maxOrderQtyAdmin" type="number" min="0" max="999"><small>۰ یعنی بدون محدودیت</small></div><div><label>پیام رسیدن به سقف</label><input id="maxOrderMessageAdmin" type="text" placeholder="سقف تعداد سفارش این کافه تکمیل شده است."></div></div>
                      <div style="margin-top:10px"><label>تم رنگی کل سایت</label><div class="theme-grid"><button type="button" class="theme-choice theme-blue" data-theme-choice="blue"><span class="theme-dot"></span>Dragon Blue</button><button type="button" class="theme-choice theme-neon" data-theme-choice="neon"><span class="theme-dot"></span>Neon Harbor</button><button type="button" class="theme-choice theme-midnight" data-theme-choice="midnight"><span class="theme-dot"></span>Midnight</button><button type="button" class="theme-choice theme-cyan" data-theme-choice="cyan"><span class="theme-dot"></span>فیروزه‌ای</button><button type="button" class="theme-choice theme-purple" data-theme-choice="purple"><span class="theme-dot"></span>بنفش</button></div></div><div class="theme-colors-panel"><div><label for="themeTextColor">رنگ متن اصلی</label><div class="color-control"><input id="themeTextColor" type="color" value="#F3F7FF"><span id="themeTextColorValue">#F3F7FF</span></div></div><div><label for="themeMutedColor">رنگ متن فرعی</label><div class="color-control"><input id="themeMutedColor" type="color" value="#9FB3D9"><span id="themeMutedColorValue">#9FB3D9</span></div></div></div>
                    </div>
                    <div class="password-change-card"><label>تغییر رمز پنل مدیریت</label><input id="newAdminPin" type="password" autocomplete="new-password" placeholder="رمز جدید را وارد کنید"><small>بعد از ورود می‌توانی رمز شخصی تعیین کنی.</small><button class="btn password-reset" type="button" onclick="resetToMasterPin()"><i class="fas fa-key"></i> بازگشت به رمز مادر</button></div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-save" onclick="saveIntegrationSettings()"><i class="fas fa-save"></i> ذخیره تنظیمات</button>
                </div>
                <div class="modal-footer-actions"><button type="button" class="modal-back-btn" onclick="closeIntegrationSettings()"><i class="fas fa-arrow-right"></i> بازگشت</button></div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop" id="brandManagerBackdrop"><div class="modal"><div class="modal-body"><div class="modal-headline"><h2><i class="fas fa-palette"></i> برند و لوگو</h2><button class="modal-close static" onclick="closeBrandManager()"><i class="fas fa-times"></i></button></div><div class="divider"></div><div class="brand-preview" id="brandPreview"><i class="fas fa-dragon"></i></div><div class="form-grid" style="margin-top:12px"><div><label>لوگوی اصلی کافه</label><div class="file-field"><label class="file-btn"><i class="fas fa-cloud-upload-alt"></i><span>انتخاب فایل لوگو</span><input id="brandLogoFile" type="file" accept="image/*"></label><span class="file-name" id="brandLogoFileName">فایلی انتخاب نشده است</span></div></div><div><label>نام کافه</label><input id="brandNameInput" type="text"></div><div><label>پیام خوش‌آمدگویی</label><textarea id="brandSubtitleInput"></textarea></div><div><label>توضیح منو</label><textarea id="menuDescriptionInput"></textarea></div></div><div class="form-actions"><button class="btn btn-save" onclick="saveBrandManager()"><i class="fas fa-save"></i> ذخیره</button></div><div class="modal-footer-actions"><button type="button" class="modal-back-btn" onclick="closeBrandManager()"><i class="fas fa-arrow-right"></i> بازگشت</button></div></div></div></div>
    <div class="modal-backdrop" id="discountManagerBackdrop"><div class="modal"><div class="modal-body"><div class="modal-headline"><h2><i class="fas fa-tags"></i> مدیریت تخفیف‌ها</h2><button class="modal-close static" onclick="closeDiscountManager()"><i class="fas fa-times"></i></button></div><div class="divider"></div><div class="form-grid"><div><label>کد تخفیف</label><input id="couponCodeAdmin" type="text" placeholder="DRAGON10"></div><div class="form-row2"><div><label>درصد تخفیف</label><input id="couponPercentAdmin" type="number" min="1" max="100"></div><div><label>حداقل خرید</label><input id="couponMinAdmin" type="number" min="0"></div></div><div class="form-row2"><div><label>شروع اعتبار</label><input id="couponStartAdmin" type="text" class="jalali-datetime" inputmode="numeric" placeholder="۱۴۰۵/۰۶/۲۶ — ۱۲:۰۰" readonly></div><div><label>پایان اعتبار</label><input id="couponEndAdmin" type="text" class="jalali-datetime" inputmode="numeric" placeholder="۱۴۰۵/۰۶/۲۶ — ۱۲:00" readonly></div></div></div><div class="form-actions"><button class="btn btn-save" onclick="addCouponAdmin()"><i class="fas fa-plus"></i> افزودن کد</button></div><div class="modal-footer-actions"><button type="button" class="modal-back-btn" onclick="closeDiscountManager()"><i class="fas fa-arrow-right"></i> بازگشت</button></div><div id="couponManagerList"></div></div></div></div>
