 48px;
                height: 48px;
                font-size: 24px;
            }
            .modal {
                max-width: 100%;
                border-radius: 20px 20px 0 0;
            }
            .modal-body {
                padding: 16px 18px 24px;
            }
            .modal-hero {
                height: 140px;
                font-size: 56px;
            }
            .form-row2 {
                flex-direction: column;
                gap: 8px;
            }
            .welcome-popup .popup-box {
                padding: 28px 20px;
            }
            .welcome-popup .popup-box .dragon-icon { font-size: 48px; }
            .welcome-popup .popup-box h2 { font-size: 22px; }
        }


.cat-manager-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;max-height:60vh;overflow:auto}
.cat-manager-row{display:grid;grid-template-columns:88px 1fr;gap:10px;align-items:center;padding:10px;border-radius:16px;background:rgba(12,35,69,.32);border:1px solid rgba(144,202,255,.16)}
.cat-manager-preview{width:88px;height:68px;border-radius:14px;overflow:hidden;background:rgba(7,20,42,.45);border:1px solid rgba(144,202,255,.18)}
.cat-manager-preview img,.cat-manager-preview svg{width:100%;height:100%;object-fit:cover;display:block}
@media(max-width:600px){.cat-manager-list{grid-template-columns:1fr}}

/* ===== DRAGON INITIAL THEME + RESPONSIVE RIGHT RAIL + NO-REMOTE-VISUALS ===== */
.visual-svg{width:100%;height:100%;display:block}
.cat-btn .ic{width:54px!important;height:54px!important;border-radius:17px!important;overflow:hidden!important;background:rgba(255,255,255,.055)!important}
.cat-btn .ic svg{width:46px;height:46px;display:block}
.item-card .img-wrap{height:255px!important;min-height:255px!important;background:linear-gradient(135deg,#182a4a,#2b4777)!important;overflow:hidden!important}
.item-card .img-wrap .visual-svg{position:absolute;inset:0;z-index:1}
.item-card .img-wrap img.real-photo{position:absolute;inset:0;z-index:2;width:100%;height:100%;object-fit:cover;display:block}
.item-card .img-wrap img.real-photo.failed{display:none}
.item-card .img-wrap .photo-fallback{position:absolute;inset:0;z-index:1}
.item-card .item-body{background:rgba(7,15,31,.18)}
.item-card{background:rgba(22,43,77,.30)!important;border-color:rgba(144,202,255,.18)!important}
.toolbar,.search-row input,.cat-heading,.bottom-bar,.modal,.admin-banner{background:rgba(21,49,88,.28)!important;border-color:rgba(144,202,255,.18)!important;backdrop-filter:blur(16px)!important;-webkit-backdrop-filter:blur(16px)!important}
.sidebar{background:rgba(9,20,42,.60)!important;backdrop-filter:blur(20px)!important;-webkit-backdrop-filter:blur(20px)!important}
.cat-btn.active .ic{background:rgba(79,179,255,.18)!important;box-shadow:0 0 28px rgba(79,179,255,.28)!important}
.add-btn,.modal-add,.bb-btn,.icon-btn,.fab-add{box-shadow:0 10px 24px rgba(44,125,220,.20),inset 0 1px 0 rgba(255,255,255,.18)!important}
.admin-tool-btn{background:rgba(25,94,160,.38)!important;border-color:rgba(144,202,255,.24)!important}
.admin-order-card{padding:12px;border-radius:16px;background:rgba(12,32,61,.45);border:1px solid rgba(144,202,255,.16);margin-bottom:10px}
.admin-order-card .meta{font-size:11px;color:var(--text-dim);line-height:1.8}
.order-status{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border-radius:999px;background:rgba(79,179,255,.14);font-size:10px;font-weight:800}
.order-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.order-actions button{padding:7px 10px;border-radius:10px;background:rgba(65,156,235,.18);color:#fff;border:1px solid rgba(144,202,255,.20);font-family:inherit}
.kitchen-col{padding:12px;border-radius:16px;background:rgba(9,27,53,.50);border:1px solid rgba(144,202,255,.16);margin-bottom:10px}
.kitchen-item{display:flex;justify-content:space-between;gap:8px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.08);font-size:12px}.kitchen-item:last-child{border-bottom:0}

@media(max-width:600px){
  :root{--sidebar-w:64px}
  .sidebar{width:64px!important}
  .main{margin-right:64px!important;padding-bottom:18px}
  .cat-btn{width:100%!important;height:76px!important;padding:7px 0!important}
  .cat-btn .ic{width:50px!important;height:50px!important;border-radius:15px!important}
  .cat-btn .ic svg{width:42px;height:42px}
  .cat-btn .lb{font-size:9px!important}
  .items{grid-template-columns:repeat(1,minmax(0,1fr))!important;gap:14px!important;padding:12px 10px 120px!important}
  .item-card .img-wrap{height:260px!important;min-height:260px!important}
  .item-name{font-size:15px!important}.item-desc{font-size:11px!important}
  .toolbar{margin:8px 7px 0!important}.cat-heading{padding:18px 12px 8px!important}
  .bottom-bar{right:calc(var(--sidebar-w) + 8px)!important;left:8px!important}
  .fab-add{right:calc(var(--sidebar-w) + 12px)!important}
}
@media(max-width:380px){
  .items{grid-template-columns:1fr!important}.item-card .img-wrap{height:240px!important;min-height:240px!important}
  .toolbar .brand-text{font-size:10px!important}
}

    
.file-btn{display:flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:10px 14px;border-radius:15px;border:1px solid rgba(144,202,255,.24);background:linear-gradient(135deg,rgba(79,179,255,.14),rgba(124,108,255,.10));color:#fff;font-family:inherit;font-size:12px;font-weight:800;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.08),0 8px 20px rgba(0,50,120,.10)}.file-btn input{display:none}.file-btn i{color:var(--blue);font-size:16px}.message-popup{position:fixed;inset:0;z-index:120;display:flex;align-items:center;justify-content:center;padding:18px;background:rgba(4,10,24,.48);backdrop-filter:blur(14px);opacity:0;visibility:hidden;pointer-events:none;transition:.25s}.message-popup.show{opacity:1;visibility:visible;pointer-events:auto}.message-box{width:min(430px,92vw);padding:28px 22px;border-radius:28px;text-align:center;background:linear-gradient(145deg,rgba(18,54,98,.96),rgba(12,25,56,.98));border:1px solid rgba(144,202,255,.28);box-shadow:0 28px 70px rgba(0,0,0,.55);transform:scale(.96);transition:.25s}.message-popup.show .message-box{transform:none}.message-logo{width:70px;height:70px;margin:0 auto 12px;border-radius:22px;display:flex;align-items:center;justify-content:center;background:rgba(79,179,255,.12);border:1px solid rgba(144,202,255,.24);overflow:hidden}.message-logo i{font-size:36px;color:var(--blue)}.message-logo img{width:100%;height:100%;object-fit:contain;padding:8px}.message-box h3{font-size:20px;margin:0 0 8px;font-weight:900}.message-box p{font-size:12px;line-height:2;color:var(--text-dim);word-break:break-word}.message-line{width:72px;height:2px;margin:14px auto;background:linear-gradient(90deg,transparent,var(--blue),var(--indigo),transparent)}.message-ok{margin-top:2px;padding:10px 22px;border-radius:14px;background:linear-gradient(135deg,var(--blue),var(--indigo));font-family:inherit;font-weight:900}.welcome-popup .popup-box{position:relative;overflow:hidden;background:linear-gradient(145deg,rgba(18,54,98,.94),rgba(9,23,48,.95));border:1px solid rgba(144,202,255,.28);box-shadow:0 30px 90px rgba(0,30,90,.48),inset 0 1px 0 rgba(255,255,255,.12);width:min(430px,92vw);padding:30px 22px}.welcome-popup .popup-box .dragon-icon{width:94px;height:94px;margin:0 auto 12px;border-radius:28px;display:flex;align-items:center;justify-content:center;background:rgba(79,179,255,.12);border:1px solid rgba(144,202,255,.25);overflow:hidden}.welcome-popup .popup-box .dragon-icon i{font-size:50px;color:var(--blue)}.welcome-popup .popup-box .dragon-icon img{width:100%;height:100%;object-fit:contain;padding:10px}.welcome-popup .popup-box h2{font-size:24px}.welcome-line{width:74px;height:3px;margin:14px auto 0;border-radius:99px;background:linear-gradient(90deg,var(--blue),var(--cyan),var(--indigo))}.bottom-bar{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr) minmax(0,1fr);align-items:stretch;gap:5px!important;padding:6px!important;border-radius:22px!important}.bottom-bar .bb-btn{min-width:0!important;width:100%;justify-content:center!important;overflow:hidden;padding:9px 4px!important;font-size:11px}.bb-label{min-width:0;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bb-cart-amount{display:inline-flex;gap:3px;align-items:baseline;max-width:100%;overflow:hidden;white-space:nowrap}.bb-cart-num{max-width:78px;overflow:hidden;text-overflow:ellipsis;font-weight:950}.bb-cart-unit{font-size:8px;font-weight:800}.add-control,.modal-qty-control{display:flex;align-items:center;justify-content:center;direction:ltr;height:42px;min-width:112px;border-radius:14px;overflow:hidden;background:linear-gradient(135deg,rgba(79,179,255,.16),rgba(124,108,255,.14));border:1px solid rgba(144,202,255,.28)}.add-control button,.modal-qty-control button{width:36px;height:100%;font-size:19px;font-weight:900}.add-control .qty-value,.modal-qty-control span{min-width:40px;text-align:center;font-size:14px;color:var(--gold);font-weight:950}.coupon-premium{margin-top:14px;padding:14px;border-radius:20px;background:linear-gradient(135deg,rgba(79,179,255,.13),rgba(124,108,255,.10));border:1px solid rgba(144,202,255,.22)}.coupon-premium-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.coupon-premium-title{font-weight:900}.coupon-premium-title i{color:var(--blue);margin-left:7px}.coupon-premium-badge{font-size:10px;padding:5px 8px;border-radius:999px;background:rgba(87,224,224,.12);color:var(--cyan)}.coupon-entry{display:grid;grid-template-columns:minmax(0,1fr) 76px;gap:8px}.coupon-input-wrap{position:relative;min-width:0}.coupon-entry input{width:100%;height:46px;padding:0 44px 0 14px;border-radius:15px;border:1px dashed rgba(144,202,255,.35);background:rgba(4,14,30,.42);color:#fff;font-family:inherit;font-size:13px;font-weight:800}.coupon-entry input::placeholder{font-family:inherit;color:var(--text-dim);font-weight:600}.ticket-icon{position:absolute;right:13px;top:50%;transform:translateY(-50%);color:var(--blue)}.coupon-result{min-height:18px;margin-top:7px;font-size:11px;color:var(--cyan)}.admin-settings-card,.password-change-card{margin-top:12px;padding:12px;border-radius:16px;background:rgba(79,179,255,.06);border:1px solid rgba(144,202,255,.16)}.admin-settings-card h3{font-size:14px;margin-bottom:10px}.admin-settings-card small,.password-change-card small{display:block;color:var(--text-dim);font-size:9px;line-height:1.7;margin-top:5px}.theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:7px}.theme-choice{padding:10px 7px;border-radius:14px;border:1px solid var(--border);background:rgba(255,255,255,.04);font-family:inherit;font-size:10px;font-weight:900}.theme-choice.active{border-color:var(--blue);box-shadow:0 0 0 2px rgba(79,179,255,.12);background:rgba(79,179,255,.10)}.theme-dot{width:22px;height:22px;border-radius:50%;margin:0 auto 6px}.theme-blue .theme-dot{background:linear-gradient(135deg,#4fb3ff,#7c6cff)}.theme-cyan .theme-dot{background:linear-gradient(135deg,#35d8d8,#2377ff)}.theme-purple .theme-dot{background:linear-gradient(135deg,#a66cff,#ff63c8)}.password-reset{margin-top:8px!important;width:100%;border:1px solid var(--border)}.login-brand{text-align:center;display:grid;gap:5px;color:var(--text-dim);font-size:11px}.login-brand strong{color:var(--text);font-size:16px}.login-dragon{width:62px;height:62px;margin:0 auto;border-radius:20px;display:flex;align-items:center;justify-content:center;background:rgba(79,179,255,.10);border:1px solid rgba(144,202,255,.20)}.login-dragon i{font-size:30px;color:var(--blue)}.login-pin{width:100%;height:54px;border-radius:18px;border:1px solid rgba(79,179,255,.30);background:rgba(8,25,52,.72);color:#fff;font-family:inherit;font-size:18px;text-align:center;direction:ltr;letter-spacing:2px}.login-submit{display:flex;align-items:center;justify-content:center;gap:8px;min-height:50px}.brand-preview{height:150px;border-radius:18px;overflow:hidden;border:1px solid var(--border);background:rgba(79,179,255,.07);display:flex;align-items:center;justify-content:center}.brand-preview i{font-size:58px;color:var(--blue)}.brand-preview img{width:100%;height:100%;object-fit:contain;padding:12px}.brand-pill .logo{overflow:hidden}.brand-pill .logo img{width:100%;height:100%;object-fit:contain;padding:3px}.price-wrap{min-width:0;overflow:hidden}.price{white-space:nowrap}.price .unit{white-space:nowrap}.cat-heading .sub{max-width:100%;overflow:hidden;text-overflow:ellipsis}
@media(max-width:600px){.bottom-bar{right:calc(var(--sidebar-w) + 5px)!important;left:5px!important;bottom:max(7px,env(safe-area-inset-bottom));grid-template-columns:minmax(0,1fr) minmax(0,1.4fr) minmax(0,1fr)!important}.bottom-bar .bb-btn{font-size:9px!important;padding:8px 2px!important}.bb-cart-num{max-width:58px}.add-control,.modal-qty-control{min-width:98px;height:40px}.add-control button,.modal-qty-control button{width:30px}.add-control .qty-value,.modal-qty-control span{min-width:34px;font-size:12px}.coupon-entry{grid-template-columns:minmax(0,1fr) 72px}.theme-grid{grid-template-columns:1fr}.welcome-popup .popup-box{padding:24px 17px}.welcome-popup .popup-box .dragon-icon{width:82px;height:82px}.message-box{width:94vw;padding:24px 17px}.modal-headline{align-items:center}.admin-mode{overflow-x:auto!important;grid-template-columns:repeat(7,minmax(88px,1fr))!important;justify-content:start!important}.admin-mode .bb-btn{white-space:nowrap}}
@media(max-width:380px){.bb-label{font-size:8px}.bottom-bar .bb-btn i{font-size:12px}.bb-cart-unit{font-size:7px}.add-control,.modal-qty-control{min-width:92px}}

/* ===== MASTER STABILITY + ADMIN GRID PATCH 2026-09-16 ===== */
.dragon-fallback-mark{display:flex;align-items:center;justify-content:center;width:100%;height:100%;font-size:42px;line-height:1;filter:drop-shadow(0 0 12px rgba(79,179,255,.38));}
.welcome-popup .popup-box .dragon-icon{flex:0 0 auto;}
.welcome-popup .popup-box .dragon-icon .dragon-fallback-mark{font-size:50px;}
.brand-pill .logo .dragon-fallback-mark{font-size:24px;}
/* Admin controls: two-column layout, no horizontal hunting/scrolling */
.bottom-bar.admin-mode{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-auto-rows:minmax(48px,auto);overflow:visible!important;white-space:normal!important;align-items:stretch!important;padding:8px!important;border-radius:22px!important;gap:8px!important;}
.bottom-bar.admin-mode .bb-btn{width:100%!important;min-width:0!important;max-width:none!important;height:48px!important;white-space:normal!important;overflow:visible!important;text-overflow:clip!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;padding:8px 10px!important;border-radius:15px!important;font-size:12px!important;}
.bottom-bar.admin-mode .bb-label{max-width:none!important;overflow:visible!important;text-overflow:clip!important;white-space:nowrap!important;font-size:11px!important;}
.bottom-bar.admin-mode .bb-btn i{font-size:14px!important;flex:0 0 auto;}
.welcome-popup .popup-box{max-height:calc(100dvh - 28px)!important;overflow:auto;}
.message-box{max-height:calc(100dvh - 28px)!important;overflow:auto;}
@media(max-width:600px){
  .bottom-bar.admin-mode{right:8px!important;left:8px!important;bottom:max(8px,env(safe-area-inset-bottom))!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important;padding:7px!important;}
  .bottom-bar.admin-mode .bb-btn{height:46px!important;padding:7px 6px!important;font-size:11px!important;}
  .bottom-bar.admin-mode .bb-label{font-size:10px!important;}
  .bottom-bar.admin-mode .bb-btn i{font-size:13px!important;}
  .welcome-popup{padding:14px!important;}
  .welcome-popup .popup-box{width:min(430px,calc(100vw - 28px))!important;padding:24px 16px!important;border-radius:26px!important;}
  .welcome-popup .popup-box .dragon-icon{width:84px!important;height:84px!important;margin-bottom:10px!important;}
