  line-height:1.2!important;
  color:rgba(255,150,150,.88)!important;
  text-decoration:line-through!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
}
.price-wrap .price{
  display:block!important;
  max-width:100%!important;
  color:#f7d77b!important;
  font-size:clamp(13px,1.7vw,17px)!important;
  line-height:1.25!important;
  font-weight:950!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
}
.price-wrap .price .unit{
  font-size:clamp(8px,1vw,10px)!important;
  color:rgba(220,235,255,.72)!important;
  font-weight:700!important;
  white-space:nowrap!important;
}
.item-foot>.add-control,.item-foot>.add-btn{flex:0 0 auto}

/* Admin bottom bar: stay beside the right category rail, never beneath it. */
.bottom-bar.admin-mode{
  z-index:60!important;
  position:fixed!important;
  right:calc(var(--sidebar-w) + 10px)!important;
  left:10px!important;
  bottom:max(10px,env(safe-area-inset-bottom))!important;
  width:auto!important;
  max-width:none!important;
  box-sizing:border-box!important;
}
.sidebar{z-index:55!important}

/* Customer cart total: one responsive line instead of a two-line stack. */
.bottom-bar:not(.admin-mode) .cart-total{
  display:flex!important;
  flex:1 1 auto!important;
  min-width:0!important;
  max-width:100%!important;
  align-items:center!important;
  justify-content:center!important;
  gap:5px!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-align:center!important;
}
.bottom-bar:not(.admin-mode) .cart-total i{flex:0 0 auto!important;grid-row:auto!important}
.bottom-bar:not(.admin-mode) .bb-cart-title{
  flex:0 1 auto!important;
  min-width:0!important;
  max-width:40px!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  white-space:nowrap!important;
  font-size:10px!important;
  line-height:1!important;
}
.bottom-bar:not(.admin-mode) .bb-cart-amount{
  flex:0 1 auto!important;
  min-width:0!important;
  max-width:calc(100% - 42px)!important;
  display:inline-flex!important;
  align-items:baseline!important;
  justify-content:center!important;
  gap:2px!important;
  overflow:hidden!important;
  white-space:nowrap!important;
  line-height:1!important;
}
.bottom-bar:not(.admin-mode) .bb-cart-num{
  min-width:0!important;
  max-width:110px!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  white-space:nowrap!important;
  font-size:clamp(8px,2.25vw,11px)!important;
  line-height:1!important;
}
.bottom-bar:not(.admin-mode) .bb-cart-unit{
  flex:0 0 auto!important;
  font-size:clamp(6px,1.7vw,8px)!important;
  line-height:1!important;
  white-space:nowrap!important;
}

@media(max-width:600px){
