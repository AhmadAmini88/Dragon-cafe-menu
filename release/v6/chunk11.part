ntById('brandLogoBox');
            if(bp)bp.innerHTML=`<img src="${logoSource}" alt="لوگوی Dragon">`;
            const wp=document.getElementById('welcomeLogoBox');
            if(wp)wp.innerHTML=`<img src="${logoSource}" alt="لوگوی Dragon">`;
            const ml=document.getElementById('messageLogo');
            if(ml)ml.innerHTML=`<img src="${logoSource}" alt="لوگوی Dragon">`;
            const lb=document.getElementById('loginDragonBox');
            if(lb)lb.innerHTML=`<img src="${DRAGON_LOGO_DATA_URL}" alt="لوگوی اصلی Dragon">`;
            const w=document.getElementById('welcomePopup');
            if(w){const h=w.querySelector('h2'),p0=w.querySelector('p');if(h)h.textContent=name;if(p0)p0.innerHTML=esc(sub)}
            const desc=document.querySelector('.cat-heading .sub');if(desc)desc.textContent=CAFE_SETTINGS.menuDescription||'قیمت به تومان';
        }
        function bindFileNamePreview(inputId,nameId){const input=document.getElementById(inputId),out=document.getElementById(nameId);if(!input||!out||input.dataset.nameBound)return;input.dataset.nameBound='1';input.addEventListener('change',()=>{const f=input.files?.[0];out.textContent=f?f.name:'فایلی انتخاب نشده است';});}
        bindFileNamePreview('brandLogoFile','brandLogoFileName');
        bindFileNamePreview('fImageFile','fImageFileName');
        async function openBrandManager(){document.getElementById('brandNameInput').value=(CAFE_SETTINGS.brandName==='DRAGON CAFE'||!CAFE_SETTINGS.brandName)?'کافه گیم دراگون':CAFE_SETTINGS.brandName;document.getElementById('brandSubtitleInput').value=CAFE_SETTINGS.brandSubtitle||'به دنیای Dragon خوش آمدید';document.getElementById('menuDescriptionInput').value=CAFE_SETTINGS.menuDescription||'قهوه، نوشیدنی، اسنک و تجربه بازی حرفه‌ای';document.getElementById('brandPreview').innerHTML=`<img src="${CAFE_SETTINGS.logoData||DRAGON_LOGO_DATA_URL}" alt="لوگوی کافه گیم دراگون">`;document.getElementById('brandManagerBackdrop').classList.add('open');syncAdminModalChrome?.()}
        function closeBrandManager(){document.getElementById('brandManagerBackdrop').classList.remove('open')}
        async function saveBrandManager(){const f=document.getElementById('brandLogoFile').files?.[0];if(f)CAFE_SETTINGS.logoData=await compressImage(f,1000,.90);CAFE_SETTINGS.brandName=document.getElementById('brandNameInput').value.trim()||'کافه گیم دراگون';CAFE_SETTINGS.brandSubtitle=document.getElementById('brandSubtitleInput').value.trim()||'به دنیای Dragon خوش آمدید';CAFE_SETTINGS.menuDescription=document.getElementById('menuDescriptionInput').value.trim();saveCafeSettings();applyCafeBrand();closeBrandManager();showMessage('برند Dragon','برند و لوگو ذخیره شد.')}
        function openDiscountManager(){if(!adminMode)return;renderCouponManager();document.getElementById('couponStartAdmin').dataset.iso='';document.getElementById('couponStartAdmin').value='';document.getElementById('couponEndAdmin').dataset.iso='';document.getElementById('couponEndAdmin').value='';document.getElementById('discountManagerBackdrop').classList.add('open');syncAdminModalChrome?.();initJalaliInputs()}
        function closeDiscountManager(){document.getElementById('discountManagerBackdrop').classList.remove('open')}
        // ==================== JALALI CALENDAR ====================
        function div(a,b){return Math.floor(a/b)}
        function jalaliG2J(gy,gm,gd){
            const g_d_m=[0,31,59,90,120,151,181,212,243,273,304,334];
            let jy=(gy<=1600)?0:979; gy-=(gy<=1600)?621:1600;
            const gy2=(gm>2)?gy+1:gy;
            let days=365*gy + div(gy2+3,4) - div(gy2+99,100) + div(gy2+399,400) - 80 + gd + g_d_m[gm-1];
            jy+=33*div(days,12053); days%=12053;
            jy+=4*div(days,1461); days%=1461;
            if(days>365){jy+=div(days-1,365);days=(days-1)%365;}
            const jm=(days<186)?1+div(days,31):7+div(days-186,30);
            const jd=1+((days<186)?(days%31):((days-186)%30));
            return [jy,jm,jd];
        }
        function jalaliJ2G(jy,jm,jd){
            let gy=(jy<=979)?621:1600; jy-=(jy<=979)?0:979;
            let days=365*jy + div(jy,33)*8 + div((jy%33)+3,4) + 78 + jd + ((jm<7)?(jm-1)*31:(jm-7)*30+186);
            gy+=400*div(days,146097); days%=146097;
            if(days>36524){gy+=100*div(--days,36524);days%=36524;if(days>=365)days++;}
            gy+=4*div(days,1461); days%=1461;
            if(days>365){gy+=div(days-1,365);days=(days-1)%365;}
            const gd=days+1;
            const sal_a=[0,31,((gy%4===0&&gy%100!==0)||gy%400===0)?29:28,31,30,31,30,31,31,30,31,30,31];
            let gm=0, rem=gd;
            for(gm=1;gm<=12;gm++){if(rem<=sal_a[gm])break;rem-=sal_a[gm]}
            return [gy,gm,rem];
        }
        function jalaliMonthDays(y,m){if(m<=6)return 31;if(m<=11)return 30;const a=jalaliJ2G(y,12,29),b=jalaliG2J(a[0],a[1],a[2]);return b[0]===y&&b[1]===12&&b[2]===29?30:29}
        const jalaliMonthNames=['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
        const jalaliWeekNames=['ش','ی','د','س','چ','پ','ج'];
        const faDigits=s=>String(s).replace(/\d/g,d=>'۰۱۲۳۴۵۶۷۸۹'[d]);
        function isoToJalaliDisplay(iso){if(!iso)return '';const d=new Date(iso);if(Number.isNaN(d.getTime()))return '';const [y,m,day]=jalaliG2J(d.getFullYear(),d.getMonth()+1,d.getDate());return `${faDigits(y)}/${faDigits(String(m).padStart(2,'0'))}/${faDigits(String(day).padStart(2,'0'))} — ${faDigits(String(d.getHours()).padStart(2,'0'))}:${faDigits(String(d.getMinutes()).padStart(2,'0'))}`}
        function jalaliInputIso(id){const el=document.getElementById(id);return el?.dataset.iso||''}
        let jalaliPickerState={inputId:null,y:null,m:null,d:null,time:'12:00'};
        let jalaliPickerEl=null;
        function makeJalaliPicker(){if(jalaliPickerEl)return jalaliPickerEl;jalaliPickerEl=document.createElement('div');jalaliPickerEl.className='jalali-picker hidden';jalaliPickerEl.innerHTML=`<div class="jalali-head"><strong id="jalaliTitle"></strong><div class="jalali-nav"><button type="button" id="jalaliPrev">‹</button><button type="button" id="jalaliNext">›</button><button type="button" class="pick-close" id="jalaliClose">×</button></div></div><div class="jalali-week" id="jalaliWeek"></div><div class="jalali-days" id="jalaliDays"></div><div class="jalali-time-row"><label>ساعت</label><input id="jalaliTime" type="time" value="12:00"></div><div class="jalali-actions"><button type="button" class="btn btn-save" id="jalaliToday">امروز</button><button type="button" class="btn btn-save" id="jalaliDone">ثبت تاریخ</button></div>`;document.body.appendChild(jalaliPickerEl);jalaliPickerEl.querySelector('#jalaliPrev').addEventListener('click',()=>{jalaliPickerState.m--;if(jalaliPickerState.m<1){jalaliPickerState.m=12;jalaliPickerState.y--;}renderJalaliPicker()});jalaliPickerEl.querySelector('#jalaliNext').addEventListener('click',()=>{jalaliPickerState.m++;if(jalaliPickerState.m>12){jalaliPickerState.m=1;jalaliPickerState.y++;}renderJalaliPicker()});jalaliPickerEl.querySelector('#jalaliClose').addEventListener('click',closeJalaliPicker);jalaliPickerEl.querySelector('#jalaliToday').addEventListener('click',()=>{const now=new Date();const [y,m,d]=jalaliG2J(now.getFullYear(),now.getMonth()+1,now.getDate());jalaliPickerState.y=y;jalaliPickerState.m=m;jalaliPickerState.d=d;jalaliPickerState.time=`${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;renderJalaliPicker()});jalaliPickerEl.querySelector('#jalaliTime').addEventListener('input',e=>jalaliPickerState.time=e.target.value);jalaliPickerEl.querySelector('#jalaliDone').addEventListener('click',commitJalaliPicker);return jalaliPickerEl}
        function renderJalaliPicker(){const p=makeJalaliPicker();p.querySelector('#jalaliTitle').textContent=`${jalaliMonthNames[jalaliPickerState.m-1]} ${faDigits(jalaliPickerState.y)}`;p.querySelector('#jalaliWeek').innerHTML=jalaliWeekNames.map(x=>`<span>${x}</span>`).join('');const [gy,gm,gd]=jalaliJ2G(jalaliPickerState.y,jalaliPickerState.m,1);let dow=new Date(gy,gm-1,gd).getDay();dow=(dow+1)%7;const days=jalaliMonthDays(jalaliPickerState.y,jalaliPickerState.m);let cells='';for(let i=0;i<dow;i++)cells+='<button class="jalali-day muted" type="button"></button>';for(let d=1;d<=days;d++)cells+=`<button type="button" class="jalali-day ${d===jalaliPickerState.d?'active':''}" data-day="${d}">${faDigits(d)}</button>`;p.querySelector('#jalaliDays').innerHTML=cells;p.querySelectorAll('[data-day]').forEach(b=>b.addEventListener('click',()=>{jalaliPickerState.d=Number(b.dataset.day);renderJalaliPicker()}));p.querySelector('#jalaliTime').value=jalaliPickerState.time;}
        function positionJalaliPicker(input){const p=makeJalaliPicker();const r=input.getBoundingClientRect();const width=Math.min(340,window.innerWidth-18);let left=Math.min(Math.max(9,r.left),window.innerWidth-width-9);let top=r.bottom+8;if(top+440>window.innerHeight)top=Math.max(9,r.top-448);p.style.left=`${left}px`;p.style.top=`${top}px`;}
        function openJalaliPicker(input){const iso=input.dataset.iso;let d=iso?new Date(iso):new Date();if(Number.isNaN(d.getTime()))d=new Date();const [y,m,day]=jalaliG2J(d.getFullYear(),d.getMonth()+1,d.getDate());jalaliPickerState={inputId:input.id,y,m,d:day,time:`${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`};renderJalaliPicker();jalaliPickerEl.classList.remove('hidden');positionJalaliPicker(input)}
        function closeJalaliPicker(){if(jalaliPickerEl)jalaliPickerEl.classList.add('hidden');jalaliPickerState.inputId=null}
        function commitJalaliPicker(){const s=jalaliPickerState;if(!s.inputId||!s.d)return;const [gy,gm,gd]=jalaliJ2G(s.y,s.m,s.d);const [hh,mm]=(s.time||'12:00').split(':').map(Number);const dt=new Date(gy,gm-1,gd,hh,mm,0,0);const input=document.getElementById(s.inputId);if(input){input.dataset.iso=dt.toISOString();input.value=`${faDigits(s.y)}/${faDigits(String(s.m).padStart(2,'0'))}/${faDigits(String(s.d).padStart(2,'0'))} — ${faDigits(String(hh).padStart(2,'0'))}:${faDigits(String(mm).padStart(2,'0'))}`;}closeJalaliPicker()}
        function initJalaliInputs(){document.querySelectorAll('.jalali-datetime').forEach(input=>{if(input.dataset.jalaliBound)return;input.dataset.jalaliBound='1';input.addEventListener('click',()=>openJalaliPicker(input));});}
        initJalaliInputs();
        window.addEventListener('resize',()=>{if(jalaliPickerEl&&!jalaliPickerEl.classList.contains('hidden')){const i=document.getElementById(jalaliPickerState.inputId);if(i)positionJalaliPicker(i)}});
        document.addEventListener('mousedown',e=>{if(jalaliPickerEl&&!jalaliPickerEl.classList.contains('hidden')&&!jalaliPickerEl.contains(e.target)&&!e.target.closest('.jalali-datetime'))closeJalaliPicker()});

        function addCouponAdmin(){const code=normalizeCouponCode(document.getElementById('couponCodeAdmin').value),percent=Number(document.getElementById('couponPercentAdmin').value),min=Number(document.getElementById('couponMinAdmin').value)||0,start=jalaliInputIso('couponStartAdmin'),end=jalaliInputIso('couponEndAdmin');if(!code||percent<1||percent>100||(start&&end&&new Date(start)>=new Date(end))){showMessage('کد تخفیف','اطلاعات کد تخفیف صحیح نیست.');return}const obj={code,percent,min,startAt:start||'',endAt:end||''};const ix=COUPONS.findIndex(x=>x.code===code);if(ix>=0)COUPONS[ix]=obj;else COUPONS.push(obj);saveCoupons();renderCouponManager();showMessage('کد تخفیف','کد تخفیف ذخیره شد.')}
        function renderCouponManager(){const b=document.getElementById('couponManagerList');if(!b)return;b.innerHTML=COUPONS.length?COUPONS.map((c,i)=>`<div class="coupon-card" style="padding:10px;margin:8px 0;border:1px solid var(--border);border-radius:14px"><b>${esc(c.code)} — ${toFa(c.percent)}٪</b><div style="font-size:10px;color:var(--text-dim)">حداقل خرید: ${toFa(c.min)} تومان · ${couponIsActive(c)?'فعال':'خارج از بازه'}</div><button class="btn btn-del" style="margin-top:8px" onclick="COUPONS.splice(${i},1);saveCoupons();renderCouponManager()">حذف</button></div>`).join(''):'<div class="cart-empty">هنوز کد تخفیفی ساخته نشده.</div>'}
        function applyCouponFromCart(){const code=normalizeCouponCode(document.getElementById('couponInput').value),c=COUPONS.find(x=>x.code===code),subtotal=Object.values(cartItems).reduce((s,x)=>s+x.quantity*x.item.price,0),out=document.getElementById('couponResult');if(!code){currentCoupon=null;updateCartUI();out.textContent='';return}if(!c){out.textContent='این کد در Dragon فعال نیست.';return}if(!couponIsActive(c)){out.textContent='این کد در بازه فعلی فعال نیست.';return}if(subtotal<c.min){out.textContent=`حداقل خرید ${toFa(c.min)} تومان است.`;return}currentCoupon=c;updateCartUI();out.textContent=`✓ تخفیف ${toFa(c.percent)}٪ اعمال شد.`}
        // ===== ORDER / KITCHEN / ZAFARAN BRIDGE =====
        function loadIntegrationSettings(){try{return JSON.parse(localStorage.getItem('gamecafe_integration')||'{}')}catch(e){return {}}}
        function openIntegrationSettings(){if(!adminMode)return;const c=loadIntegrationSettings();document.getElementById('apiBaseUrl').value=c.baseUrl||'';document.getElementById('apiToken').value=c.token||'';document.getElementById('apiEnabled').checked=!!c.enabled;document.getElementById('newAdminPin').value='';document.getElementById('maxOrderQtyAdmin').value=CAFE_SETTINGS.maxOrderQty||'';document.getElementById('maxOrderMessageAdmin').value=CAFE_SETTINGS.maxOrderMessage||'';applyTheme(CAFE_SETTINGS.theme||'blue');applyTextColors(CAFE_SETTINGS.textColor||'#f3f7ff',CAFE_SETTINGS.textMutedColor||'#9fb3d9');document.getElementById('integrationBackdrop').classList.add('open');syncAdminModalChrome?.()}
        function closeIntegrationSettings(){document.getElementById('integrationBackdrop').classList.remove('open')}
        function saveIntegrationSettings(){const np=document.getElementById('newAdminPin').value.trim();if(np&&np.length<6){showMessage('رمز مدیریت','رمز جدید باید حداقل ۶ کاراکتر باشد.');return}if(np)setAdminPin(np);CAFE_SETTINGS.maxOrderQty=Math.max(0,Math.floor(Number(document.getElementById('maxOrderQtyAdmin').value)||0));CAFE_SETTINGS.maxOrderMessage=(document.getElementById('maxOrderMessageAdmin').value||'سقف تعداد سفارش این کافه تکمیل شده است.').trim();applyTextColors(document.getElementById('themeTextColor')?.value||CAFE_SETTINGS.textColor,document.getElementById('themeMutedColor')?.value||CAFE_SETTINGS.textMutedColor);saveCafeSettings();localStorage.setItem('gamecafe_integration',JSON.stringify({baseUrl:document.getElementById('apiBaseUrl').value.trim(),token:document.getElementById('apiToken').value.trim(),enabled:document.getElementById('apiEnabled').checked}));closeIntegrationSettings();showMessage('تنظیمات','تنظیمات ذخیره شد.')}
        function getOrders(){try{return JSON.parse(localStorage.getItem('gamecafe_orders')||'[]')}catch(e){return []}}
        function saveOrders(v){localStorage.setItem('gamecafe_orders',JSON.stringify(v.slice(0,200)))}
        const statusLabels={new:'جدید',confirmed:'تأیید شد',preparing:'در حال آماده‌سازی',ready:'آماده',served:'تحویل شد'};
        function orderNextStatus(s){return s==='new'?'confirmed':s==='confirmed'?'preparing':s==='preparing'?'ready':s==='ready'?'served':'served'}
        function openOrderManager(){if(!adminMode)return; const box=document.getElementById('orderManagerList'); const os=getOrders(); box.innerHTML=os.length?os.map(o=>`<div class="admin-order-card"><div style="display:flex;justify-content:space-between;gap:8px;align-items:center"><strong>سفارش ${o.id}</strong><span class="order-status">${statusLabels[o.status]||o.status}</span></div><div class="meta">میز: ${esc(o.table)}<br>${new Date(o.createdAt).toLocaleString('fa-IR')}</div><div style="margin-top:8px;line-height:1.9">${o.items.map(i=>`${esc(i.name)} × ${toFa(i.qty)}`).join('<br>')}</div><div style="margin-top:8px;font-weight:900;color:var(--gold)">${toFa(o.total)} تومان</div><div class="order-actions">
