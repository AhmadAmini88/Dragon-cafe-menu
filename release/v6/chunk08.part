          badge: { t: 'داغ', c: 'hot' }, emoji: '🍕' },
            { id: 12, cat: 'snacks', name: 'چیکن استریپس', desc: '۵ تکه سوخاری، سرو با سس باربیکیو', price: 130000,
                emoji: '🍗' },
            { id: 13, cat: 'ps5', name: 'PS5 استاندارد', desc: '۲ دسته، کتابخانه کامل بازی‌ها — ساعتی', price: 90000,
                unit: 'ساعت', emoji: '🎮' },
            { id: 14, cat: 'ps5', name: 'PS5 اتاق VIP', desc: 'اتاق دربسته، صندلی ریسینگ، ساعتی', price: 130000,
                unit: 'ساعت', featured: true, badge: { t: 'VIP', c: 'hot' }, emoji: '🎮' },
            { id: 15, cat: 'pc', name: 'PC ریسینگ سری', desc: 'فرمان و پدال اختصاصی، صندلی ریسینگ — ساعتی', price: 80000,
                unit: 'ساعت', emoji: '🖥️' },
            { id: 16, cat: 'pc', name: 'PC رقابتی (اسپرت)', desc: 'مانیتور ۲۴۰هرتز، ماوس و کیبورد حرفه‌ای — ساعتی',
                price: 95000, unit: 'ساعت', badge: { t: 'پرطرفدار', c: 'new' }, emoji: '🖥️' },
            { id: 17, cat: 'xbox', name: 'Xbox Series X', desc: 'Game Pass فعال، ۲ دسته — ساعتی', price: 85000,
                unit: 'ساعت', emoji: '🕹️' },
            { id: 18, cat: 'vr', name: 'تجربه VR', desc: 'هدست کامل، اتاق حرکت آزاد — ساعتی', price: 150000, unit: 'ساعت',
                featured: true, badge: { t: 'جدید', c: 'new' }, emoji: '🥽' },
            { id: 19, cat: 'combo', name: 'کمبو گیمر تکی', desc: '۲ ساعت PS5 + یک نوشیدنی سرد + سیب‌زمینی', price: 220000,
                emoji: '🔥' },
            { id: 20, cat: 'combo', name: 'کمبو دونفره', desc: '۱ ساعت PC دونفره + ۲ نوشیدنی دلخواه', price: 180000,
                featured: true, badge: { t: 'ویژه', c: '' }, emoji: '🔥' },
        ];
        // ITEMS_END
        const BUILTIN_ITEMS = ITEMS.map(x => ({...x}));

        // ==================== STATE ====================
        let activeCat = 'featured';
        let cartItems = {};
        let adminMode = false;
        let searchQuery = '';
        let editingId = null;
        let currentCoupon = null;
        let CAFE_SETTINGS = (()=>{try{const v=JSON.parse(localStorage.getItem('gamecafe_settings')||'{}');return (v&&typeof v==='object'&&!Array.isArray(v))?v:{}}catch(_){return {}}})();
        let COUPONS = (()=>{try{const v=JSON.parse(localStorage.getItem('gamecafe_coupons')||'[]');return Array.isArray(v)?v:[]}catch(_){return []}})();
        let CAT_META = (()=>{try{const v=JSON.parse(localStorage.getItem('gamecafe_cat_meta')||'{}');return (v&&typeof v==='object'&&!Array.isArray(v))?v:{}}catch(_){return {}}})();
        const DRAGON_LOGO_DATA_URL = './images/dragon_logo.webp';
        const MASTER_ADMIN_PIN = 'T3228195tt!';
        const DEFAULT_ADMIN_PIN = MASTER_ADMIN_PIN;
        function getAdminPin(){try{const v=localStorage.getItem('gamecafe_admin_pin');return (!v||v==='1234')?MASTER_ADMIN_PIN:v}catch(_){return MASTER_ADMIN_PIN}}
        function setAdminPin(pin){try{localStorage.setItem('gamecafe_admin_pin',pin)}catch(_){}
        }
        function saveCafeSettings(){try{localStorage.setItem('gamecafe_settings',JSON.stringify(CAFE_SETTINGS))}catch(_){}
        }
        function saveCoupons(){try{localStorage.setItem('gamecafe_coupons',JSON.stringify(COUPONS))}catch(_){}
        }
        function normalizeCouponCode(v){return String(v||'').trim().toUpperCase().replace(/\s+/g,'')}
        function couponIsActive(c){const now=Date.now();const st=c.startAt?new Date(c.startAt).getTime():-Infinity;const en=c.endAt?new Date(c.endAt).getTime():Infinity;return now>=st&&now<=en}

        // ==================== HELPERS ====================
        const toFa = n => Number(n).toLocaleString('en-US').replace(/[0-9]/g, d => '۰۱۲۳۴۵۶۷۸۹'[d]);
        const catOf = id => CATS.find(c => c.id === id) || CATS[0];
        const getImage = (imgName) => {
            if (!imgName) return '';
            // اگر نام تصویر شامل مسیر نباشد، از پوشه images استفاده کن
            if (imgName.includes('/')) return imgName;
            return 'images/' + imgName;
        };

        function saveData() {
            try {
                localStorage.setItem('gamecafe_items', JSON.stringify(ITEMS));
                localStorage.setItem('gamecafe_cart', JSON.stringify(cartItems));
                localStorage.setItem('gamecafe_cat_images', JSON.stringify(CUSTOM_CAT_IMAGES));
            } catch (_) {}
        }

        function loadData(){
            try{
                const raw=localStorage.getItem('gamecafe_items');
                if(raw){
                    const parsed=JSON.parse(raw);
                    if(Array.isArray(parsed)){
                        const clean=parsed.filter(x=>x&&x.id!=null&&x.cat&&typeof x.name==='string'&&x.name.trim());
                        if(clean.length>0) ITEMS=clean;
                        else localStorage.removeItem('gamecafe_items');
                    }
                }
                if(!Array.isArray(ITEMS)||ITEMS.length===0) ITEMS=BUILTIN_ITEMS.map(x=>({...x}));

                const cartRaw=localStorage.getItem('gamecafe_cart');
                if(cartRaw){
                    const parsed=JSON.parse(cartRaw);
                    if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed)){
                        const clean={};
                        for(const [id,entry] of Object.entries(parsed)){
                            const item=ITEMS.find(x=>String(x.id)===String(id));
                            const q=Math.max(0,Math.floor(Number(entry?.quantity)||0));
                            if(item&&q>0) clean[id]={item,quantity:q};
                        }
                        cartItems=clean;
                    }
                }
                const imgs=localStorage.getItem('gamecafe_cat_images');
                if(imgs){const parsed=JSON.parse(imgs);if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed))CUSTOM_CAT_IMAGES=parsed}
            }catch(_){
                ITEMS=Array.isArray(BUILTIN_ITEMS)&&BUILTIN_ITEMS.length?BUILTIN_ITEMS.map(x=>({...x})):[];
                cartItems={};
            }
        }
        loadData();
        const tableParam=new URLSearchParams(location.search).get('table');
        let currentTable='';let sessionLockedTable='';try{sessionLockedTable=sessionStorage.getItem('dragon_table_lock')||''}catch(_){}
        let qrTableConflict=false;if(tableParam){if(sessionLockedTable&&sessionLockedTable!==tableParam)qrTableConflict=true;else{try{sessionStorage.setItem('dragon_table_lock',tableParam)}catch(_){} }}
        currentTable=qrTableConflict?sessionLockedTable:(tableParam||sessionLockedTable||localStorage.getItem('gamecafe_table')||'');if(tableParam&&!qrTableConflict)localStorage.setItem('gamecafe_table',tableParam);


        // ===== EMBEDDED SKEUOMORPHIC VISUALS =====
        const esc = s => String(s||'').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
        function svgShell(inner, label=''){
            return `<svg class="visual-svg" viewBox="0 0 600 360" preserveAspectRatio="xMidYMid slice" role="img" aria-label="${esc(label)}" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="bg${Math.random().toString(36).slice(2)}" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#13274a"/><stop offset="1" stop-color="#2d5791"/></linearGradient>
                <linearGradient id="metal" x1="0" x2="1"><stop stop-color="#f4f7fb"/><stop offset=".45" stop-color="#c9d1db"/><stop offset="1" stop-color="#7d8998"/></linearGradient>
                <linearGradient id="blueMetal" x1="0" x2="1"><stop stop-color="#7ddcff"/><stop offset=".5" stop-color="#2e8cf0"/><stop offset="1" stop-color="#1750a6"/></linearGradient>
                <radialGradient id="glow"><stop stop-color="#ffffff" stop-opacity=".72"/><stop offset="1" stop-color="#ffffff" stop-opacity="0"/></radialGradient>
                <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="16" stdDeviation="12" flood-color="#061225" flood-opacity=".55"/></filter>
                <filter id="soft"><feGaussianBlur stdDeviation="10"/></filter>
              </defs>
              <rect width="600" height="360" rx="30" fill="url(#bg)"/>
              <circle cx="470" cy="65" r="120" fill="url(#glow)" opacity=".15"/>
              <ellipse cx="300" cy="305" rx="235" ry="26" fill="#081427" opacity=".45" filter="url(#soft)"/>
              ${inner}
            </svg>`;
        }
        function catVisual(id,label){
          const base=(body)=>svgShell(body,label);
          if(id==='ps5') return base(`<g filter="url(#shadow)"><rect x="175" y="58" width="122" height="240" rx="20" fill="#f4f5f7"/><path d="M210 76h50c18 0 33 15 33 33v173h-83z" fill="#131923"/><rect x="201" y="126" width="69" height="7" rx="3" fill="#4fb3ff" opacity=".7"/><ellipse cx="390" cy="246" rx="110" ry="30" fill="#cfd7e2"/><path d="M336 216c25-31 83-31 108 0 10 13 20 29 15 48-2 9-12 13-21 11l-47-14-49 14c-10 3-19-2-22-11-6-18 5-35 16-48z" fill="url(#metal)"/><circle cx="370" cy="252" r="16" fill="#1c2634"/><circle cx="432" cy="252" r="16" fill="#1c2634"/><circle cx="401" cy="241" r="5" fill="#2c78dd"/><circle cx="401" cy="263" r="5" fill="#2c78dd"/><path d="M351 232l12 12m-12 0 12-12m88 0-12 12m12 0-12-12" stroke="#294157" stroke-width="7" stroke-linecap="round"/></g>`);
          if(id==='pc') return base(`<g filter="url(#shadow)"><rect x="115" y="62" width="330" height="195" rx="18" fill="#111a28" stroke="#7ddcff" stroke-opacity=".45"/><rect x="130" y="77" width="300" height="165" rx="11" fill="#0b1320"/><path d="M148 211c36-72 89-97 136-108 44-11 87 3 130 49v47z" fill="#235aa1" opacity=".55"/><path d="M170 206c48-66 94-86 147-85 43 0 73 14 103 35" fill="none" stroke="#74e0ff" stroke-width="6" opacity=".7"/><rect x="229" y="264" width="103" height="13" rx="7" fill="#778392"/><rect x="165" y="284" width="228" height="12" rx="6" fill="#9aa6b5"/><rect x="465" y="72" width="74" height="211" rx="14" fill="#101923" stroke="#5cb9ff" stroke-opacity=".42"/><circle cx="502" cy="112" r="15" fill="#52d4ff"/><circle cx="502" cy="156" r="15" fill="#7a73ff"/><circle cx="502" cy="200" r="15" fill="#4de08a"/></g>`);
          if(id==='xbox') return base(`<g filter="url(#shadow)"><rect x="164" y="60" width="148" height="244" rx="20" fill="#17231d" stroke="#55db8b" stroke-opacity=".45"/><rect x="192" y="85" width="92" height="145" rx="10" fill="#0c120f"/><path d="M214 246h49" stroke="#58df8c" stroke-width="7" stroke-linecap="round"/><ellipse cx="400" cy="245" rx="105" ry="29" fill="#e0e4e9"/><path d="M346 214c27-28 79-28 107 0 12 13 21 29 17 45-3 12-13 17-24 14l-42-12-42 12c-11 3-21-3-24-14-4-16 5-32 8-45z" fill="#f0f3f6"/><circle cx="369" cy="252" r="15" fill="#2f3439"/><circle cx="430" cy="252" r="15" fill="#2f3439"/><circle cx="398" cy="241" r="5" fill="#41cf78"/><circle cx="398" cy="263" r="5" fill="#41cf78"/></g>`);
          if(id==='vr') return base(`<g filter="url(#shadow)"><path d="M150 116c0-25 20-45 45-45h210c25 0 45 20 45 45v75c0 25-20 45-45 45h-79l-27 28h-36l-27-28h-41c-25 0-45-20-45-45z" fill="#e9eff4"/><path d="M195 113h210c10 0 18 8 18 18v51c0 10-8 18-18 18H195c-10 0-18-8-18-18v-51c0-10 8-18 18-18z" fill="#101924"/><rect x="222" y="133" width="66" height="44" rx="22" fill="#2b9fe8" opacity=".7"/><rect x="312" y="133" width="66" height="44" rx="22" fill="#755fff" opacity=".65"/><circle cx="255" cy="156" r="10" fill="#c8f7ff" opacity=".6"/><circle cx="345" cy="156" r="10" fill="#e7dcff" opacity=".6"/></g>`);
          if(id==='hot') return base(`<g filter="url(#shadow)"><ellipse cx="300" cy="285" rx="150" ry="22" fill="#141a25" opacity=".5"/><path d="M190 125h220v92c0 48-49 73-110 73s-110-25-110-73z" fill="#f2f3f5"/><path d="M207 141h186v63c0 41-41 62-93 62s-93-21-93-62z" fill="#3c1f18"/><path d="M205 145c52-24 139-24 190 0" stroke="#7a4738" stroke-width="8" opacity=".45"/><path d="M275 112c-14-22 4-36 9-49m28 50c-8-23 12-32 13-49m-40 50c-3-18-22-23-25-40" stroke="#e6eef7" stroke-width="10" stroke-linecap="round" opacity=".38"/></g>`);
          if(id==='cold') return base(`<g filter="url(#shadow)"><path d="M215 92h170l-14 202H229z" fill="#dfeaf3" opacity=".9"/><path d="M226 158h148l-8 123H236z" fill="#65dcff" opacity=".75"/><circle cx="270" cy="212" r="18" fill="#ffffff" opacity=".7"/><circle cx="324" cy="236" r="12" fill="#e7ffff" opacity=".65"/><circle cx="347" cy="194" r="14" fill="#ffffff" opacity=".55"/><path d="M295 94c5-28 30-34 42-4" stroke="#f3f8ff" stroke-width="8" stroke-linecap="round"/><path d="M205 118c60 10 130 10 190 0" stroke="#dff8ff" stroke-width="9" stroke-linecap="round"/><path d="M257 143c16-27 30-35 51-39" stroke="#82eaff" stroke-width="8" stroke-linecap="round" opacity=".8"/></g>`);
          if(id==='snacks') return base(`<g filter="url(#shadow)"><path d="M157 122l54 165h177l54-165z" fill="#e9b34e"/><path d="M171 129h257l-31 120H201z" fill="#f6f0df" opacity=".22"/><g fill="#f7ce57"><rect x="208" y="118" width="28" height="126" rx="7" transform="rotate(-8 222 181)"/><rect x="245" y="110" width="28" height="132" rx="7" transform="rotate(-4 259 176)"/><rect x="282" y="106" width="28" height="136" rx="7"/><rect x="319" y="110" width="28" height="132" rx="7" transform="rotate(5 333 176)"/><rect x="356" y="119" width="28" height="126" rx="7" transform="rotate(9 370 182)"/></g><circle cx="432" cy="217" r="21" fill="#ff6f3d"/><circle cx="432" cy="217" r="10" fill="#fff3d5"/></g>`);
          if(id==='combo') return base(`<g filter="url(#shadow)"><rect x="132" y="135" width="190" height="105" rx="18" fill="#e6ecf1"/><circle cx="210" cy="187" r="43" fill="#2c9fff" opacity=".45"/><path d="M345 95h102l18 145H327z" fill="#f2f5f7"/><path d="M365 116h62l16 104h-65z" fill="#54bde8" opacity=".65"/><path d="M128 105c20-35 36 0 55-37 16-28 34 2 49-22 13-21 30 3 40-12" stroke="#ff7b57" stroke-width="13" fill="none" stroke-linecap="round"/></g>`);
          return base(`<g filter="url(#shadow)"><rect x="170" y="92" width="260" height="188" rx="28" fill="#1a3158" stroke="#7ddcff" stroke-opacity=".45"/><path d="M300 116l18 36 40 6-29 28 7 40-36-19-36 19 7-40-29-28 40-6z" fill="#ffd166"/></g>`);
        }
        function productType(item){
          const n=(item.name||'').toLowerCase(); const c=item.cat;
          if(c==='ps5' || n.includes('ps5')) return 'ps5';
          if(c==='pc' || n.includes('pc')) return 'pc';
          if(c==='xbox' || n.includes('xbox')) return 'xbox';
          if(c==='vr' || n.includes('vr')) return 'vr';
          if(c==='hot' || /اسپرس|کاپو|لاته|موکا|قهوه/.test(n)) return 'hot';
          if(c==='cold' || /موهیتو|آیس|اسموتی|انرژی/.test(n)) return 'cold';
          if(c==='snacks' || /سیب|ناچوز|پیتزا|چیکن|برگر/.test(n)) return 'snacks';
          if(c==='combo') return 'combo';
          return c||'featured';
        }
        function visualForItem(item){return `<img class="site-logo-fallback" src="${DRAGON_LOGO_DATA_URL}" alt="لوگوی کافه گیم دراگون">`;}
        function visualForCat(c){return `<img class="site-logo-fallback cat-logo-fallback" src="${DRAGON_LOGO_DATA_URL}" alt="لوگوی کافه گیم دراگون">`;}
        function catImage(id){return CUSTOM_CAT_IMAGES[id] || '';}

        // ==================== RENDER ====================
        function renderSidebar() {
            const el = document.getElementById('sidebar');
            el.innerHTML = CATS.map(c => `
                    <button class="cat-btn ${c.id === activeCat ? 'active' : ''}" data-cat="${c.id}" aria-label="${esc(c.label)}">
                        <span class="ic">${catImage(c.id) ? `<img src="${catImage(c.id)}" alt="${esc(c.label)}">` : visualForCat(c)}</span>
                        <span class="lb">${esc(CAT_META[c.id]?.label||c.label)}</span>
                    </button>
                `).join('');
            el.querySelectorAll('.cat-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    activeCat = btn.dataset.cat;
                    searchQuery = '';
                    docu