                    <!-- تصویر محصول: آپلود محلی یا URL -->
                    <div>
                        <label>تصویر واقعی محصول</label>
                        <div class="file-field">
                            <label class="file-btn"><i class="fas fa-cloud-upload-alt"></i><span>انتخاب تصویر محصول</span><input id="fImageFile" type="file" accept="image/*"></label>
                            <span class="file-name" id="fImageFileName">فایلی انتخاب نشده است</span>
                        </div>
                        <input id="fImage" type="text" placeholder="یا URL تصویر (اختیاری)" style="margin-top:8px;">
                        <small style="display:block;color:var(--text-dim);margin-top:6px;line-height:1.7;">عکس آپلودی داخل همین منو ذخیره می‌شود و برای نمایش به اینترنت وابسته نیست.</small>
                    </div>
                    <div class="chk-row"><input type="checkbox" id="fFeatured"> نمایش در «ویژه»</div>
                    <div class="chk-row"><input type="checkbox" id="fSoldout"> ناموجود</div>
                </div>
                <div class="form-actions">
                    <button class="btn btn-del" id="fDelete" style="display:none;"><i class="fas fa-trash"></i> حذف</button>
                    <button class="btn btn-save" id="fSave"><i class="fas fa-save"></i> ذخیره</button>
                </div>
                <div class="modal-footer-actions"><button type="button" class="modal-back-btn" onclick="closeForm()"><i class="fas fa-arrow-right"></i> بازگشت</button></div>
            </div>
        </div>
    </div>

