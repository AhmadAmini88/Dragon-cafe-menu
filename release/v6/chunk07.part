            { id: 'hot', label: 'گرم', icon: '☕', grad: 'linear-gradient(135deg,#3a2b1f,#ffd166)' },
            { id: 'cold', label: 'سرد', icon: '🧊', grad: 'linear-gradient(135deg,#1c3a4a,#57e0e0)' },
            { id: 'snacks', label: 'اسنک', icon: '🍟', grad: 'linear-gradient(135deg,#3a2b1f,#ff9a4d)' },
            { id: 'ps5', label: 'PS5', icon: '🎮', grad: 'linear-gradient(135deg,#2a2058,#7c6cff)' },
            { id: 'pc', label: 'PC', icon: '🖥️', grad: 'linear-gradient(135deg,#1c3350,#4fb3ff)' },
            { id: 'xbox', label: 'Xbox', icon: '🕹️', grad: 'linear-gradient(135deg,#1f3a2a,#57e08a)' },
            { id: 'vr', label: 'VR', icon: '🥽', grad: 'linear-gradient(135deg,#2a1f4a,#b06bff)' },
            { id: 'combo', label: 'کمبو', icon: '🔥', grad: 'linear-gradient(135deg,#3a1f2b,#ff6b81)' },
        ];

        const CAT_IMAGES = {};
        let CUSTOM_CAT_IMAGES = {};

        // آیتم‌های پیش‌فرض با ایموجی و تصویر
        // ITEMS_START
        let ITEMS = [
            { id: 1, cat: 'hot', name: 'اسپرسو دوبل', desc: 'شات دوبل، تلخ و پرانرژی برای شروع بازی', price: 45000,
                emoji: '☕' },
            { id: 2, cat: 'hot', name: 'کاپوچینو', desc: 'اسپرسو با شیر بخار داده و فوم غلیظ', price: 55000, emoji: '☕' },
            { id: 3, cat: 'hot', name: 'لاته وانیل', desc: 'قهوه ملایم با سیراپ وانیل فرانسوی', price: 65000, oldPrice: 75000,
                featured: true, badge: { t: 'ویژه', c: '' }, emoji: '☕' },
            { id: 4, cat: 'hot', name: 'موکای شکلاتی', desc: 'اسپرسو، شکلات تلخ بلژیکی و خامه', price: 70000, emoji: '☕' },
            { id: 5, cat: 'cold', name: 'آیس لاته', desc: 'قهوه سرد روی یخ با شیر تازه', price: 65000, emoji: '🧊' },
            { id: 6, cat: 'cold', name: 'موهیتو نعنا', desc: 'لیموی تازه، نعنا و سودای گازدار', price: 75000, emoji: '🧊' },
            { id: 7, cat: 'cold', name: 'اسموتی توت‌فرنگی', desc: 'توت‌فرنگی تازه، ماست و عسل طبیعی', price: 85000,
                badge: { t: 'جدید', c: 'new' }, emoji: '🍓' },
            { id: 8, cat: 'cold', name: 'انرژی‌زا میکس', desc: 'ردبول با آبمیوه طبیعی و یخ خرد', price: 95000, emoji: '⚡' },
            { id: 9, cat: 'snacks', name: 'سیب‌زمینی سرخ‌کرده', desc: 'ترد و داغ، سرو با سس چیلی‌میو', price: 90000,
                emoji: '🍟' },
            { id: 10, cat: 'snacks', name: 'ناچوز پنیری', desc: 'چیپس ذرت، سس پنیر مخصوص و پیکو دو گایو', price: 120000,
                oldPrice: 140000, featured: true, badge: { t: 'ویژه', c: '' }, emoji: '🧀' },
            { id: 11, cat: 'snacks', name: 'پیتزا مینی پپرونی', desc: 'خمیر نازک، پپرونی و پنیر موزارلا', price: 110000,
